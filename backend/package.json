{
  "name": "quanlyphongtro-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Boarding house management API using the official MongoDB driver",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node src/scripts/setup.js",
    "db:seed": "node src/scripts/seed.js",
    "user:create-admin": "node src/scripts/createAdmin.js",
