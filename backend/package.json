    "test:integration": "node --test test/integration/*.test.js",
    "check": "node src/scripts/check.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
